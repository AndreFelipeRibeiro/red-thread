# macOS
.DS_Store

# Claude Code / local tooling. Project skills are shared (Notion "Figma ⇄
# code check 1/2: tokens"); everything else under .claude/ stays local.
.claude/*
!.claude/skills/

# Local credentials, auth state and private diagnostics
.env
.env.*
!.env.example
.secrets/
*.pem
*.key
*.p12
*.pfx
*.har
*.log
*.dump
*.sqlite
*.sqlite3
backups/
supabase/.temp/

# QA tooling (qa/): installed packages, downloaded libraries, screenshots
qa/node_modules/
qa/package-lock.json
qa/vendor/
qa/shots/
# Left by qa/precompile.js, which cached Babel-compiled scripts for the checks
# until the app became a bundle and that file became qa/serve-site.js. Nothing
# writes here any more; the entry stays so an old directory does not show up as
# untracked. Safe to delete locally.
qa/.cache/
# A check run from the repository root (as qa/README.md says to) resolves its
# screenshot path to ./shots/ rather than qa/shots/.
/shots/


# Editor swap files (an open vim session leaves .<name>.swp beside the file).
*.swp

# V4 build step (Vite): installed packages and the built site.
node_modules/
dist/
tools/poster-colors-report.html
