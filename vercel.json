{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/:path*",
      "missing": [{ "type": "host", "value": "redthread\\.tv" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mcu-connections\\.vercel\\.app" }],
      "destination": "https://redthread.tv/:path*",
      "permanent": true
    },
    {
      "source": "/og-image.jpg",
      "destination": "/og/default.jpg",
      "permanent": true
    },
    {
      "source": "/og/default.png",
      "destination": "/og/default.jpg",
      "permanent": true
    },
    {
      "source": "/og/:kind/:id.png",
      "destination": "/og/:kind/:id.jpg",
      "permanent": true
    }
  ]
}
